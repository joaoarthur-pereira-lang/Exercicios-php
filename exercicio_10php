<?php

function calcularMedia(notas) {
    let maior = Math.max(...notas);
    let menor = Math.min(...notas);

    let soma = 0;

    for (let nota of notas) {
        soma += nota;
    }

    let media = soma / notas.length;

    let situacao;

    if (media >= 7) {
        situacao = "Aprovado";
    } else if (media >= 5) {
        situacao = "Recuperação";
    } else {
        situacao = "Reprovado";
    }

    return {
        maiorNota: maior,
        menorNota: menor,
        media: media,
        situacaoFinal: situacao
    };
}

// Exemplo
let notas = [8, 6, 7, 9];

console.log(calcularMedia(notas));
?>